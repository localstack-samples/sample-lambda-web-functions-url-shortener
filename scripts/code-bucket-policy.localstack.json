{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowLambdaToReadTheCode",
      "Effect": "Allow",
      "Principal": {"Service": "lambda.amazonaws.com"},
      "Action": ["s3:GetObject", "s3:GetObjectVersion"],
      "Resource": "arn:aws:s3:::shortener-code/*",
      "Condition": {
        "ArnLike": {"aws:SourceArn": "arn:aws:lambda:us-east-1:000000000000:web-function/shortener/revision/*"}
      }
    }
  ]
}
