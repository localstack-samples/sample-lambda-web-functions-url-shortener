{"Version":"2012-10-17","Statement":[
 {"Sid":"Logs","Effect":"Allow","Action":["logs:CreateLogGroup","logs:CreateLogStream","logs:PutLogEvents"],"Resource":["arn:aws:logs:{{REGION}}:{{ACCOUNT}}:log-group:/aws/lambda/web/{{FN}}:*","arn:aws:logs:{{REGION}}:{{ACCOUNT}}:log-group:/aws/lambda/web/{{FN}}.local:*"]},
 {"Sid":"Links","Effect":"Allow","Action":["dynamodb:GetItem","dynamodb:PutItem","dynamodb:UpdateItem","dynamodb:Scan"],"Resource":"arn:aws:dynamodb:{{REGION}}:{{ACCOUNT}}:table/{{TABLE}}"},
 {"Sid":"QrImages","Effect":"Allow","Action":["s3:PutObject","s3:GetObject"],"Resource":"arn:aws:s3:::{{QR_BUCKET}}/*"}
]}
